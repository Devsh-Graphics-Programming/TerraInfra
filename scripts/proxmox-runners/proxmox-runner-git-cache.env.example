INSTALL_DIR=/etc/proxmox-runner-git-cache
CACHE_ROOT=/var/lib/proxmox-runner-git-cache
BLOB_CACHE_ROOT=/var/lib/proxmox-runner-git-cache/blobs
BLOB_CACHE_ALLOWED_PREFIXES=runner-cache/
BLOB_CACHE_MAX_BYTES=536870912
BLOB_FETCH_ALLOWED_URL_PREFIXES=
BLOB_FETCH_TIMEOUT_SECONDS=300
SCRATCH_ROOT=/var/lib/proxmox-runner-scratch
SCRATCH_SMB_SHARE=runner-scratch
SCRATCH_SMB_HOSTS_ALLOW=10.254.254.0/24 127.
SCRATCH_UNC_ROOT=\\10.254.254.254\runner-scratch
ENABLE_SCRATCH_SMB=true
CONFIG_FILE=/etc/proxmox-runner-git-cache/repos.json
CONFIG_SOURCE=/root/proxmox-runner-git-cache.repos.json
LISTEN_HOST=10.254.254.254
API_PORT=18082
GIT_PORT=9418
PUBLIC_GIT_BASE_URL=git://10.254.254.254:9418
PYTHON_BIN=/usr/bin/python3
GIT_BIN=/usr/bin/git
GIT_SSH_COMMAND_VALUE=ssh -F /etc/proxmox-runner-git-cache/ssh_config
